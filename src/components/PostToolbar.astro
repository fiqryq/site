---
import Icon from './Icon.astro'
---

<div class="toolbar">
  <a href="/" class="button">
    <Icon name="chevron-left" />
    Back
  </a>
  <div class="actions">
    <button type="button" class="button" data-copy="page">
      <span class="idle"><Icon name="copy" /> Copy page</span>
      <span class="done"><Icon name="check" /> Copied</span>
    </button>
    <button type="button" class="button icon-only" data-copy="link" aria-label="Copy link">
      <span class="idle"><Icon name="link" /></span>
      <span class="done"><Icon name="check" /></span>
    </button>
  </div>
</div>

<style>
  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .actions {
    display: flex;
    gap: 0.5rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    height: 2rem;
    padding-inline: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-foreground);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    box-shadow: var(--shadow-xs);
    cursor: pointer;
    transition: background-color 150ms;
  }

  .button:hover {
    background-color: var(--color-surface);
  }

  .icon-only {
    width: 2rem;
    justify-content: center;
    padding: 0;
  }

  .idle,
  .done {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .done,
  [data-copied] .idle {
    display: none;
  }

  [data-copied] .done {
    display: inline-flex;
  }

  a.button {
    gap: 0.375rem;
  }
</style>

<script>
  const article = document.querySelector<HTMLElement>('[data-article]')

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    let timeout: number | undefined

    button.addEventListener('click', async () => {
      const text =
        button.dataset.copy === 'link' ? window.location.href : (article?.innerText ?? '')

      try {
        await navigator.clipboard.writeText(text)
      } catch {
        return
      }

      button.dataset.copied = ''
      window.clearTimeout(timeout)
      timeout = window.setTimeout(() => delete button.dataset.copied, 1500)
    })
  }
</script>
