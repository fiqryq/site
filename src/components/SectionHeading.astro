---
// Matches the article section headings: medium weight, trailing hairline rule.
interface Props {
  id: string
  class?: string
  style?: string
}

const { id, class: className, style } = Astro.props
---

<h2 id={id} class:list={['heading', className]} style={style}><slot /></h2>

<style>
  .heading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    font-size: 1rem;
    font-weight: 550;
    line-height: 1.625;
    color: var(--color-heading);
  }

  .heading::after {
    content: "";
    flex: 1;
    height: 1px;
    background-color: var(--color-line);
  }
</style>
