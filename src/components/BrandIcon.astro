interface Props {
  name: keyof typeof marks
  size?: number
  class?: string
}

const { name, size = 14, class: className } = Astro.props
const { viewBox, body } = marks[name]
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox={viewBox}
  fill="none"
  aria-hidden="true"
  class={className}
  set:html={body}
/>
