---
import LinkRow from '@/components/LinkRow.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { formatWordCount, getLogEntries, getLogEntryUrl } from '@/lib/log'
import { getProjects } from '@/lib/projects'

const [projects, entries] = await Promise.all([getProjects(), getLogEntries()])

const nameWords = ['Fiqry', 'Choerudin']
// Staggered entrance: the name word by word, then each block in reading order.
const introStart = nameWords.length
const projectsStart = introStart + 2
const logStart = projectsStart + projects.length + 1
---

<BaseLayout>
  <div class="container page">
    <header>
      <h1>
        {
          nameWords.map((word, i) => (
            <>
              {i > 0 && ' '}
              <span class="word animate-enter" style={`--stagger: ${i}; --delay: 80ms`}>
                {word}
              </span>
            </>
          ))
        }
      </h1>
      <p class="role animate-enter" style={`--stagger: ${introStart}`}>Frontend Engineer</p>
      <p class="bio animate-enter" style={`--stagger: ${introStart + 1}`}>
        Software Engineer based in Indonesia, currently at Kitabisa. I mainly work with React and
        enjoy building web applications. I spend my free time experimenting with side projects on
        GitHub and fine-tuning my Neovim setup.
      </p>
    </header>

    <section aria-labelledby="projects-heading">
      <SectionHeading
        id="projects-heading"
        class="animate-enter"
        style={`--stagger: ${projectsStart}`}
      >
        projects.
      </SectionHeading>
      <ul role="list" class="rows">
        {
          projects.map((project, i) => (
            <li class="animate-enter" style={`--stagger: ${projectsStart + 1 + i}`}>
              <LinkRow
                href={project.data.url}
                title={project.data.name}
                description={project.data.description}
                icon={project.data.icon}
                external
              />
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="log-heading">
      <SectionHeading id="log-heading" class="animate-enter" style={`--stagger: ${logStart}`}>
        log.
      </SectionHeading>
      <ol role="list" class="rows">
        {
          entries.map((entry, i) => (
            <li class="animate-enter" style={`--stagger: ${logStart + 1 + i}`}>
              <LinkRow
                href={getLogEntryUrl(entry)}
                title={entry.data.title}
                meta={formatWordCount(entry.data.wordCount)}
              />
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 3rem;
  }

  h1 {
    font-size: 1rem;
    font-weight: 550;
    line-height: 1.625;
    color: var(--color-heading);
    text-wrap: balance;
  }

  /* Words animate individually, so each needs its own box to transform. */
  .word {
    display: inline-block;
  }

  .role {
    color: var(--color-muted);
  }

  .bio {
    margin-top: 1.25rem;
    color: var(--color-body);
    text-wrap: pretty;
  }

  section {
    margin-top: 4rem;
  }

  /* Hairline between rows, like the interfaces.dev issue list. */
  .rows > li + li {
    border-top: 1px solid var(--color-surface);
  }

  @media (min-width: 640px) {
    .page {
      padding-block: 6rem;
    }
  }
</style>
